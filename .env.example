# Gemini API (server-side only — NEVER expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Firebase (served at runtime via GET /api/config — NOT baked into client build)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Server
PORT=3001
NODE_ENV=development

# Google Maps Platform (optional — enables "Find Real Vendors" feature)
# Enable "Places API (New)" in Google Cloud Console, then add key here.
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_MAPS_API_KEY=

# Rate limiting (generation endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
